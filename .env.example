# ============= DATABASE (PostgreSQL + pgvector) =============
DATABASE_URL=postgresql://dev:dev_password@localhost:5432/rag_search_dev
REDIS_URL=redis://localhost:6379

# ============= API SERVER =============
PORT=8080
API_PORT=8080
API_URL=http://localhost:8080
NODE_ENV=development

# ============= AUTHENTICATION & JWT =============
JWT_SECRET=super-secret-jwt-key-minimum-32-characters-long-example
JWT_REFRESH_SECRET=super-secret-refresh-jwt-key-minimum-32-characters-long-example

# ============= GOOGLE GEMINI (PRIMARY LLM & EMBEDDINGS) =============
# Get a free API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001

# ============= GEMINI RERANKER (RECOMMENDED: SEPARATE API KEY) =============
# TIP: Using a dedicated second API key for the reranker avoids hitting free-tier RPM limits!
GEMINI_RERANKER_API_KEY=
GEMINI_RERANKER_MODEL=gemini-3.5-flash-lite

# ============= MCP SERVER =============
MCP_API_TOKEN=mcp-secret-token-rag-2026
MCP_PORT=3002

# ============= FRONTEND =============
NEXT_PUBLIC_API_URL=http://localhost:8080
FRONTEND_URL=http://localhost:3000

# ============= INGESTION & CHUNKING =============
CHUNK_SIZE=512
CHUNK_OVERLAP=50
MAX_INGESTION_RETRIES=3
